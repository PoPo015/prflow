{
  "name": "prflow",
  "version": "0.2.0",
  "description": "AI와 함께 PR을 흐름으로 읽으며 새로운 코드를 공부하는 로컬 리뷰 도구",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PoPo015/prflow.git"
  },
  "homepage": "https://github.com/PoPo015/prflow#readme",
  "keywords": [
    "code-review",
    "pull-request",
    "claude-code",
    "developer-tools",
    "visualization"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "prflow": "bin/prflow.mjs"
  },
  "files": [
    "bin",
    "dist",
    "scripts/analyze.mjs",
    "scripts/doctor.mjs",
    "scripts/flow.schema.json",
    "server"
  ],
  "scripts": {
    "dev": "vite --port 4173",
    "build": "tsc --noEmit && vite build",
    "analyze": "node scripts/analyze.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify": "node scripts/verify.mjs",
    "prepublishOnly": "npm run build",
    "start": "node bin/prflow.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@xyflow/react": "^13.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
